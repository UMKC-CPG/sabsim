#!/bin/bash
# prep_surf2_sio2.library — build surface 2's ENVIRONMENT LIBRARY (DESIGN §3.5),
# from the recipe in prep_surf2_sio2/, into that folder. Step 0 of the
# guide: once per recipe, on the bootstrap's clock, not a job of the
# pair chain (DESIGN §10.2). Generated by `sabsim prepare`.
# Lean by design (§10.5): scheduler directives, modules, frozen
# roots, and the run line. The interpreter, launcher, and
# potentials come from the activated install (the sourced
# .sabsim/sabsimrc), so they are NOT restated here.
#SBATCH --job-name=prep_surf2_sio2.library
#SBATCH --partition=gpu,requeue
#SBATCH --account=general
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:H100:1
#SBATCH --mem=48G
#SBATCH --time=12:00:00
#SBATCH --output=/cluster/pixstor/home/rulisp/CPG/cpg-repo/sabsim/jobs/si_sio2/prep_surf2_sio2.library-%j.out
#SBATCH --error=/cluster/pixstor/home/rulisp/CPG/cpg-repo/sabsim/jobs/si_sio2/prep_surf2_sio2.library-%j.err

set -euo pipefail

# The CPG modulefile tree is not on the default path (§4.4).
module use /cluster/VAST/rulisp-lab/cpg/modulefiles

# Location roots, frozen at prepare time (§10.5, §1.4).
export SABSIM_SCRATCH="/home/rulisp/data/scratch/sabsim"
export SABSIM_SHARE="/cluster/VAST/rulisp-lab/cpg"

# Per-kind environment, frozen from the rc (§4.4).
export SABSIM_CASCADE_ENGINE_PREFIX="/cluster/VAST/rulisp-lab/cpg/programs/deepmd-kit-3.2.0b0-cuda129"

# The bootstrap's home is the PREP folder: the recipe is read
# there and the library is written there (ARCHITECTURE §1).
cd "/cluster/pixstor/home/rulisp/CPG/cpg-repo/sabsim/jobs/si_sio2/prep_surf2_sio2"

# Never overwrite a library (§10.8). To rebuild after changing
# the recipe, move environment_library.toml and .npz aside.
if [ -f "environment_library.toml" ]; then
    echo "prep_surf2_sio2.library: prep_surf2_sio2/environment_library.toml is already there; left untouched."
    exit 0
fi

# Launch inside the allocation (§4.1). `srun --mpi=pmix` is the
# primary launcher (§4.1), NOT mpirun: mpirun's remote daemon does
# not preserve the venv on other nodes, so a remote rank falls back
# to the conda-env python that lacks the editable sabsim (diagnosed
# job 15697153); srun carries the activated venv to every node. The
# allocation also exports SLURM_MEM_PER_NODE/_CPU/_GPU as mutually
# exclusive, which aborts the nested launch, so clear them first.
unset SLURM_MEM_PER_NODE SLURM_MEM_PER_CPU SLURM_MEM_PER_GPU
srun --mpi=pmix -n "${SLURM_NTASKS}" python -m sabsim bootstrap generate \
    recipe.toml --skip-collection2

echo "prep_surf2_sio2.library done. Check the self-check numbers in prep_surf2_sio2/environment_library.toml, then submit: sbatch prep_surf2_sio2.slurm"
